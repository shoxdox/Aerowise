# REVIEW PROPOSAL ONLY. Do not copy to the live edge until separately approved.
# Temporary GET/HEAD root redirect after the approved staging candidate passes its checks.
# Authenticated paths, APIs and signed homeowner/renewal/invoice/estimate links stay on production.
{
    email {$ACME_EMAIL}
}

{$STAGING_DOMAIN} {
    encode gzip
    reverse_proxy aerowise-staging-web:3000
}

{$PRODUCTION_DOMAIN} {
    encode gzip
    @public_home {
        path /
        method GET HEAD
    }
    redir @public_home https://staging.deshain.com 302
    reverse_proxy aerowise-production-web:3000
}
