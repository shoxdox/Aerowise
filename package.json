{
  "name": "aerowise",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @aerowise/db migrate",
    "db:seed": "pnpm --filter @aerowise/db seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
