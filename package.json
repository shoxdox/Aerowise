{
  "name": "aerowise",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @aerowise/db migrate",
    "db:seed": "pnpm --filter @aerowise/db seed && pnpm --filter @aerowise/api demo-story",
    "db:reseed-demo": "pnpm --filter @aerowise/db reseed-demo && pnpm --filter @aerowise/api demo-story",
    "db:create-platform-admin": "pnpm --filter @aerowise/db exec tsx src/cli.ts create-platform-admin",
    "files:copy-to-r2": "pnpm --filter @aerowise/storage exec tsx src/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
