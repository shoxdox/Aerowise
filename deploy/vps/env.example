# /etc/aerowise/<env>.env on the server, one per environment, readable by root and the deploy
# user only. deploy/vps/setup.sh writes it with new secrets (or: openssl rand -hex 32).
AW_ENV=staging
# The environment's address, without https://: staging.<domain> or app.<domain>. Must match
# /etc/aerowise/edge.env.
AW_DOMAIN=staging.example.com
# Set once: the database keeps the password it was created with.
POSTGRES_PASSWORD=
# The port the web app listens on, on the server itself only (nginx sends traffic here):
# 3101 for staging, 3102 for production.
AW_WEB_PORT=3101
FILE_SIGNING_SECRET=
# true on staging only: every outside service is a test stand-in, and the demo banner shows.
DEMO_MODE=true
# Email. Without RESEND_API_KEY every email is written to the outbox on the server instead of sent.
# Production requires Resend. Staging with Resend requires EMAIL_REDIRECT_TO (one test inbox).
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_REDIRECT_TO=
FILING_EMAIL_FROM=
INVOICE_EMAIL_FROM=
ACCOUNT_EMAIL_FROM=
# Who hears about demo requests from the marketing page (comma-separated); empty: every platform admin.
DEMO_REQUEST_NOTIFY_TO=
# Cloudflare R2 for photos and PDFs (all four, or none for the server's disk). Required in production.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Backups (deploy/vps/backup.sh, docs/engineering/RUNBOOK.md). With the R2 lines above filled in,
# each nightly backup is also copied to backups/<env>/ in that bucket and read back. Optionally a
# separate bucket or token for backups (recommended: a token the app does not hold).
BACKUP_R2_BUCKET=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Days to keep copies in R2 (on the server: 14).
BACKUP_OFFSITE_KEEP_DAYS=35
# A dead man's switch (for example a Healthchecks.io check, daily, with a grace period of a few
# hours): pinged after each backup that finished and was copied off, so a missed one emails you.
BACKUP_HEARTBEAT_URL=
# What companies pay Aerowise (W4). Empty uses the defaults in .env.example.
# Stripe Billing on Aerowise's own Stripe account (not homeowner payments); webhook for invoice.*
# events at https://<AW_DOMAIN>/api/webhooks/stripe-billing. Empty: months are counted, not invoiced.
STRIPE_BILLING_SECRET_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_BILLING_PRODUCT_ID=
AEROWISE_TRIAL_DAYS=
AEROWISE_DESIGN_PARTNER_DAYS=
AEROWISE_PRICE_PER_CONTRACT_CENTS=
AEROWISE_MONTHLY_MINIMUM_CENTS=
AEROWISE_PAST_DUE_GRACE_DAYS=
# Optional: unexpected errors and queue alerts go to Sentry (the project's DSN) as well as the logs.
SENTRY_DSN=
# Production only, when each service is set up. Left empty, each one is off in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
QUICKBOOKS_TOKEN_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
