# /etc/aerowise/edge.env on the server: the addresses Caddy serves and gets certificates for.
# Each needs a DNS record pointing at the server (in Cloudflare: "DNS only", grey cloud).
STAGING_DOMAIN=staging.example.com
PRODUCTION_DOMAIN=app.example.com
# Let's Encrypt writes here about certificates that are about to expire.
ACME_EMAIL=
