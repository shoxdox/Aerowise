# Copy to .env for local development outside Docker. Never commit real secrets.
DATABASE_URL=postgres://aerowise:aerowise@localhost:5432/aerowise
TEST_DATABASE_URL=postgres://aerowise:aerowise@localhost:5432/aerowise_test
API_PORT=4000
# Where the web app proxies /api requests.
API_URL=http://localhost:4000
# Set to "production" to mark session cookies Secure and hide the OpenAPI endpoints. In production
# the API and worker refuse to start until the configuration is complete, and name what is missing.
NODE_ENV=development
# "true" only for the hosted demo (staging): every outside service (email, texts, Stripe, QuickBooks,
# the geocoder, filings) uses its test stand-in whatever keys are set, the fictional example rules
# load, the web app shows a demo banner, and `pnpm db:reseed-demo` may reset the database. Never in production.
DEMO_MODE=false
# Staging only: outside services the demo uses for real anyway, comma-separated, so they can be
# tried end to end. Each must be in a mode where nothing real happens, or the demo refuses to start:
# "stripe" needs a test-mode STRIPE_SECRET_KEY (sk_test_). See docs/engineering/INTEGRATIONS.md.
DEMO_LIVE_SERVICES=
# With NODE_ENV=production: "staging" or "production". Production also requires Resend and R2;
# staging requires EMAIL_REDIRECT_TO whenever Resend is configured.
DEPLOY_ENV=
# The proxies in front of the API whose X-Forwarded-For to believe ("true", or their addresses or
# ranges, comma-separated). Rate limits key on the client address. Leave empty unless every request
# passes through those proxies, or clients could make up addresses.
TRUST_PROXY=
# Logs are JSON lines on stdout (API and worker): trace, debug, info, warn or error.
LOG_LEVEL=info
# Unexpected errors and queue alerts go to Sentry when this is set (the project's DSN, from
# Sentry's project settings). Empty: they are only in the logs.
SENTRY_DSN=
# How often the worker checks for a stalled queue or a filing task that keeps failing (ms).
QUEUE_CHECK_INTERVAL_MS=300000
# Uploaded photos, report PDFs and outbox mail are stored here (a Docker volume in compose)
# unless Cloudflare R2 is configured below.
FILE_STORAGE_DIR=.data/files
# Cloudflare R2 (private bucket, S3 API token with object read and write on that bucket only).
# Set all four to store files in R2 instead of FILE_STORAGE_DIR; setting only some is refused.
# Copy existing files across with `pnpm files:copy-to-r2` (checks every file's SHA-256).
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Another S3-compatible endpoint instead of R2's (for a local test bucket). Normally empty.
R2_ENDPOINT=
# Signs short-lived file links. Required when NODE_ENV=production; use a long random value.
FILE_SIGNING_SECRET=
# From address on filing emails. Its domain must be verified in Resend.
FILING_EMAIL_FROM=
# The web app's public address, used in invoice pay links and Stripe's return pages.
PUBLIC_APP_URL=http://localhost:3000
# From address on invoice emails (the provider's name is shown with it).
INVOICE_EMAIL_FROM=
# From address on account emails (user invitations).
ACCOUNT_EMAIL_FROM=
# Who is emailed about a demo request from the marketing page (comma-separated; sent from
# ACCOUNT_EMAIL_FROM). Empty means every active platform admin.
DEMO_REQUEST_NOTIFY_TO=
# Resend, for email. Without a key, every email is written to an outbox in file storage instead
# of being sent. Point Resend's webhooks at <PUBLIC_APP_URL>/api/webhooks/email; the signing
# secret (whsec_...) may list several, comma-separated.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Staging: send every email to this one test inbox instead of the real recipient.
EMAIL_REDIRECT_TO=
# Stripe (Connect). Without a key, a built-in test provider runs outside production and online
# payments are off in production. STRIPE_WEBHOOK_SECRET may list several secrets, comma-separated
# (the account and Connect webhook endpoints each have one). Staging takes only test-mode keys.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# QuickBooks Online (an Intuit developer app). Without a client id, a built-in test company runs
# outside production and QuickBooks is off in production. Register <PUBLIC_APP_URL>/api/quickbooks/callback
# as the app's redirect URI. QUICKBOOKS_ENVIRONMENT is "sandbox" (default) or "production".
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
# Encrypts stored QuickBooks tokens: 32 random bytes as hex or base64. Required in production with QuickBooks.
QUICKBOOKS_TOKEN_KEY=
# How often the worker syncs each connected company, in milliseconds (changes also trigger a sync).
QUICKBOOKS_SYNC_INTERVAL_MS=300000
# Twilio, for text messages. Without these, a built-in test provider runs outside production and
# texting is off in production. Point the number's incoming messages at <PUBLIC_APP_URL>/api/webhooks/sms/inbound.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Where Twilio reaches the API (replies and delivery receipts). Defaults to <PUBLIC_APP_URL>/api.
SMS_WEBHOOK_BASE_URL=
# How often the worker looks for invoices due a payment reminder text, in milliseconds.
SMS_SWEEP_INTERVAL_MS=3600000

# Optional, for `pnpm db:create-platform-admin` only: the new admin's password, instead of typing it
# on stdin. Leave unset; never store a real admin password here.
# PLATFORM_ADMIN_PASSWORD=

# What companies pay Aerowise (W4). Unset values use the brief's starting assumptions:
# a 30-day trial, a 90-day design-partner period, $1.50 per active contract per month and a
# $99 monthly minimum. Founder prices are set per organization in /admin, not here.
AEROWISE_TRIAL_DAYS=
AEROWISE_DESIGN_PARTNER_DAYS=
AEROWISE_PRICE_PER_CONTRACT_CENTS=
AEROWISE_MONTHLY_MINIMUM_CENTS=
# The worker touches this file after every pass of its loop; `pnpm --filter @aerowise/worker health`
# fails when it is missing or older than WORKER_HEARTBEAT_MAX_AGE_MS. Defaults to a file in the temp dir.
WORKER_HEARTBEAT_FILE=
WORKER_HEARTBEAT_MAX_AGE_MS=300000
# "true" where the API and the worker share one machine (the hosted setup): the API's /health then
# also fails when the worker's heartbeat is old, so the host restarts both. See docs/engineering/DEPLOY.md.
HEALTH_INCLUDES_WORKER=false
# Stripe Billing: what companies pay Aerowise, on Aerowise's own Stripe account. Separate from the
# Connect keys above (homeowner payments). Without a key, a built-in test provider runs outside
# production; in production months are counted but not invoiced. Point a webhook for invoice.*
# events at <PUBLIC_APP_URL>/api/webhooks/stripe-billing. STRIPE_BILLING_PRODUCT_ID (optional)
# is the Aerowise product invoice lines are priced on; without it lines are plain amounts.
STRIPE_BILLING_SECRET_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_BILLING_PRODUCT_ID=
# How often the worker looks at each organization's monthly count and invoice, in milliseconds.
BILLING_RUN_INTERVAL_MS=3600000
