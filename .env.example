# Copy to .env for local development outside Docker. Never commit real secrets.
DATABASE_URL=postgres://aerowise:aerowise@localhost:5432/aerowise
TEST_DATABASE_URL=postgres://aerowise:aerowise@localhost:5432/aerowise_test
API_PORT=4000
# Where the web app proxies /api requests.
API_URL=http://localhost:4000
# Set to "production" to mark session cookies Secure and hide the OpenAPI endpoints.
NODE_ENV=development
# Uploaded photos are stored here (a Docker volume in compose).
FILE_STORAGE_DIR=.data/files
# Signs short-lived file links. Required when NODE_ENV=production; use a long random value.
FILE_SIGNING_SECRET=
# From address on filing emails. Its domain must be verified in Resend.
FILING_EMAIL_FROM=
# The web app's public address, used in invoice pay links and Stripe's return pages.
PUBLIC_APP_URL=http://localhost:3000
# From address on invoice emails (the provider's name is shown with it).
INVOICE_EMAIL_FROM=
# From address on account emails (user invitations).
ACCOUNT_EMAIL_FROM=
# Resend, for email. Without a key, every email is written to an outbox in file storage instead
# of being sent. Point Resend's webhooks at <PUBLIC_APP_URL>/api/webhooks/email; the signing
# secret (whsec_...) may list several, comma-separated.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Staging: send every email to this one test inbox instead of the real recipient.
EMAIL_REDIRECT_TO=
# Stripe (Connect). Without a key, a built-in test provider runs outside production and online
# payments are off in production. STRIPE_WEBHOOK_SECRET may list several secrets, comma-separated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# QuickBooks Online (an Intuit developer app). Without a client id, a built-in test company runs
# outside production and QuickBooks is off in production. Register <PUBLIC_APP_URL>/api/quickbooks/callback
# as the app's redirect URI. QUICKBOOKS_ENVIRONMENT is "sandbox" (default) or "production".
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
# Encrypts stored QuickBooks tokens: 32 random bytes as hex or base64. Required in production with QuickBooks.
QUICKBOOKS_TOKEN_KEY=
# How often the worker syncs each connected company, in milliseconds (changes also trigger a sync).
QUICKBOOKS_SYNC_INTERVAL_MS=300000
# Twilio, for text messages. Without these, a built-in test provider runs outside production and
# texting is off in production. Point the number's incoming messages at <PUBLIC_APP_URL>/api/webhooks/sms/inbound.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Where Twilio reaches the API (replies and delivery receipts). Defaults to <PUBLIC_APP_URL>/api.
SMS_WEBHOOK_BASE_URL=
# How often the worker looks for invoices due a payment reminder text, in milliseconds.
SMS_SWEEP_INTERVAL_MS=3600000

# Optional, for `pnpm db:create-platform-admin` only: the new admin's password, instead of typing it
# on stdin. Leave unset; never store a real admin password here.
# PLATFORM_ADMIN_PASSWORD=

# The worker touches this file after every pass of its loop; `pnpm --filter @aerowise/worker health`
# fails when it is missing or older than WORKER_HEARTBEAT_MAX_AGE_MS. Defaults to a file in the temp dir.
WORKER_HEARTBEAT_FILE=
WORKER_HEARTBEAT_MAX_AGE_MS=300000
# "true" where the API and the worker share one machine (the hosted setup): the API's /health then
# also fails when the worker's heartbeat is old, so the host restarts both. See docs/engineering/DEPLOY.md.
HEALTH_INCLUDES_WORKER=false
